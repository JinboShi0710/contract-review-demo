# 复制此文件为 .env 并填入真实配置
# cp .env.example .env

# LLM 配置（必填）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# JWT 认证（必填，生产环境必须更换）
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 应用配置（可选）
APP_NAME=ContractLens
APP_VERSION=1.0.0
DEBUG=false

# 数据库（可选，默认 SQLite）
DATABASE_URL=sqlite:///./data/contract_review.db

# 文件目录（可选）
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# 图片和扫描件使用远程 OCR 时必填
OCR_API_TOKEN=your_ocr_api_token_here
